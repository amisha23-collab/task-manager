# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/task-manager

# JWT (use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TASKS_TTL_SECONDS=600

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_TASKS_INDEX=tasks

# Redis API rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=900

# Task reminders
REMINDER_CHECK_INTERVAL_MS=60000

# Email (optional; configure with your SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=